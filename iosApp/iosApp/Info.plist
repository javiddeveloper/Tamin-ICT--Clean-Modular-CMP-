<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>2.1</string>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TaminHamrah needs access to save images to your photo library.</string>
	<key>NSCameraUsageDescription</key>
	<string>TaminHamrah uses the camera to scan QR codes for model sharing.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>TaminHamrah uses Face ID to securely sign you in.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>TaminHamrah</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.tamin.taminhamrah</string>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mytamin</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.tamin.taminhamrah.mytamin</string>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>CSSearchableItemActionType</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allow HTTP to local ComfyUI / SD WebUI / Tailscale connections (same as Android usesCleartextTraffic) -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tamin.taminhamrah.modelUpdateCheck</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIAppFonts</key>
    <array>
        <string>regular.ttf</string>
        <string>light.ttf</string>
        <string>medium.ttf</string>
        <string>semi_bold.ttf</string>
    </array>
</dict>
</plist>
