<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_item_blue"
            android:elevation="2dp"
            android:paddingBottom="@dimen/_10sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitleDebitNumber"
                    style="@style/TextStyle.SubTitle"
                    android:layout_margin="@dimen/_10sdp"
                    android:text="@string/label_debit_number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvValueDebitNumber"
                    style="@style/TextStyle.Title"
                    android:layout_width="0dp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:ellipsize="end"
                    android:gravity="right|center_vertical"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintBottom_toBottomOf="@+id/tvValueExecutiveNotificationDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvValueExecutiveNotificationDate"
                    app:layout_constraintTop_toTopOf="@+id/tvValueExecutiveNotificationDate"
                    tools:text="234234234" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitleExecutiveNotificationDate"
                    style="@style/TextStyle.SubTitle"
                    android:layout_margin="@dimen/_10sdp"
                    android:text="@string/date_executive_notification"
                    app:layout_constraintEnd_toEndOf="@+id/tvValueExecutiveNotificationDate"
                    app:layout_constraintStart_toStartOf="@+id/tvValueExecutiveNotificationDate"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvValueExecutiveNotificationDate"
                    style="@style/TextStyle.Title"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_btn_orange_light"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    app:layout_constraintEnd_toStartOf="@+id/tvValueDebitNumber"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitleExecutiveNotificationDate"
                    tools:text="1401/01/02" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/line_height"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:background="@color/lineColor"
                    app:layout_constraintTop_toBottomOf="@id/tvValueDebitNumber" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    style="@style/LinearRecyclerStyle"
                    android:layout_width="match_parent"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@+id/line1" />

                <View
                    android:id="@+id/line2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/line_height"
                    android:background="@color/lineColor"
                    app:layout_constraintTop_toBottomOf="@id/recycler" />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAction"
                    style="@style/TextButtonBordered.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/label_actions"
                    android:textSize="@dimen/font_sub_title_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btnShowDetail"
                    app:layout_constraintTop_toBottomOf="@+id/line2" />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnShowDetail"
                    style="@style/TextButton"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="@string/show_detail"
                    android:textSize="@dimen/font_sub_title_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnAction"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
