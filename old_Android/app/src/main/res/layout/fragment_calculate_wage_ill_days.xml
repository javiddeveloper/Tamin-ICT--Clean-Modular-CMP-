<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewmodel"
            type="com.tamin.taminhamrah.ui.home.services.calculateWageIllDays.CalculateWageIllDaysViewModel" />

        <variable
            name="Total_Salary"
            type="String" />
        <variable
            name="Amount_Payable"
            type="String" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true"
        android:layoutDirection="ltr">

        <include
            android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:id="@+id/nestedScrollView"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:layoutDirection="ltr">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelTitle"
                    style="@style/TextStyle.Title"
                    android:layout_marginTop="@dimen/margin_24dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:text="@string/label_specifications_ill_days"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <include
                    android:id="@+id/widgetDatePickerEnd"
                    layout="@layout/widget_date_picker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:hint='@{@string/label_end_date_rest}'
                    app:layout_constraintEnd_toEndOf="@+id/widgetDatePickerStart"
                    app:layout_constraintStart_toStartOf="@+id/widgetDatePickerStart"
                    app:layout_constraintTop_toBottomOf="@+id/widgetDatePickerStart" />


                <include
                    android:id="@+id/widgetDatePickerStart"
                    layout="@layout/widget_date_picker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    app:hint='@{@string/label_start_date_rest}'
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/labelTitle" />

                <com.tamin.taminhamrah.widget.edittext.SelectableItemView
                    android:id="@+id/select_marital_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:editText_hint="@string/hint_select_marital"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:layout_constraintEnd_toEndOf="@+id/widgetDatePickerEnd"
                    app:layout_constraintStart_toStartOf="@+id/widgetDatePickerEnd"
                    app:layout_constraintTop_toBottomOf="@+id/widgetDatePickerEnd" />


                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupShowillDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:constraint_referenced_ids="imageView2, valueDiffrentIllDay" />



                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_circle_orange"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:layout_constraintEnd_toEndOf="@+id/select_marital_status"
                    app:layout_constraintTop_toBottomOf="@+id/select_marital_status" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/valueDiffrentIllDay"
                    style="@style/TextStyle.SubTitle"
                    android:layout_marginEnd="@dimen/margin_5dp"
                    android:gravity="center"
                    android:text="@string/label_ill_days"
                    android:visibility="visible"
                    app:layout_constraintEnd_toStartOf="@+id/imageView2"
                    app:layout_constraintTop_toTopOf="@+id/imageView2" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCal"
                    style="@style/MainButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/margin_16dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_16dp"
                    android:text="@string/label_calculate_ill_wage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/valueDiffrentIllDay" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/root_layout_result"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    android:elevation="@dimen/margin_5dp"
                    android:layout_marginTop="@dimen/corner_radius_35dp"
                    android:layoutDirection="ltr"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnCal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    >


                    <View
                        android:id="@+id/containerWorkshopInformation"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_left_corner_rounded_indigo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rootLayoutWorkshopInformation"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/AmountPayableValueTitle"
                            style="@style/TextStyle.Title.Bold"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="@dimen/margin_20dp"
                            android:padding="@dimen/margin_20dp"
                            android:text="@string/the_amount_payable"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/AmountPayableValue"
                            style="@style/TextStyle.SubTitle.Green"
                            android:layout_width="wrap_content"
                            android:text="@{Amount_Payable}"
                            android:layout_marginStart="@dimen/margin_10dp"
                            app:layout_constraintBottom_toBottomOf="@+id/AmountPayableValueTitle"
                            app:layout_constraintStart_toEndOf="@+id/labelAmountPayableRial"
                            app:layout_constraintTop_toTopOf="@+id/AmountPayableValueTitle"
                            tools:text="30,124,325" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/labelAmountPayableRial"
                            style="@style/TextStyle.SubTitle"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="ریال"
                            app:layout_constraintBottom_toBottomOf="@+id/AmountPayableValue"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/AmountPayableValue"
                            tools:text="ریال" />


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/SumSalaryLastTwoYearsTitle"
                            style="@style/TextStyle.Title"
                            android:layout_width="wrap_content"
                            android:padding="@dimen/margin_20dp"
                            android:text="@string/avarage_salary_last_90_day"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/AmountPayableValueTitle" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/SumSalaryLastTwoYearsTitleValue"
                            style="@style/TextStyle.SubTitle"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="@{Total_Salary}"
                            app:layout_constraintBottom_toBottomOf="@+id/SumSalaryLastTwoYearsTitle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/SumSalaryLastTwoYearsTitle"
                            tools:text="200,123,658" />


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>