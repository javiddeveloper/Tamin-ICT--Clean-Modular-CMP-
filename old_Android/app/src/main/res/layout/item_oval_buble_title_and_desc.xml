<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <data>
        <variable
            name="title"
            type="String" />
        <variable
            name="desc"
            type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_workshop_name">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWorkShopCodeTitle"
            style="@style/TextStyle.SubTitle"
            android:gravity="center"
            android:paddingStart="@dimen/margin_5dp"
            android:paddingLeft="@dimen/margin_10dp"
            android:paddingEnd="@dimen/margin_10dp"
            android:paddingRight="@dimen/margin_10dp"
            android:layout_marginTop="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:text="@{title}"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvInsuranceCodeValue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="@string/status_payment_label" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvInsuranceCodeValue"
            style="@style/TextStyle.SubTitle"
            android:gravity="center"
            android:paddingStart="@dimen/margin_10dp"
            android:paddingLeft="@dimen/margin_10dp"
            android:paddingEnd="@dimen/margin_5dp"
            android:paddingRight="@dimen/margin_10dp"
            android:text="@{desc}"
            android:layout_marginTop="@dimen/margin_5dp"
            android:layout_marginBottom="@dimen/margin_5dp"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toStartOf="@+id/tvWorkShopCodeTitle"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="sdfsdfsdf" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
