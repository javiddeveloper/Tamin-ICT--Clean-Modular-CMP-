<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.tamin.taminhamrah.data.entity.EnumTextColor" />

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.tamin.taminhamrah.data.entity.KeyValueModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvKey"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20sdp"
            android:ellipsize="end"
            android:gravity="right"
            android:text='@{item._key}'
            android:textColor='?attr/colorOnSurface'
            android:textDirection="rtl"
            android:textSize='@{item._isHeader?@dimen/font_title_size:@dimen/font_sub_title_size}'
            app:layout_constraintBottom_toBottomOf="@+id/tvValue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_center"
            app:layout_constraintTop_toTopOf="@+id/tvValue"
            tools:text="انعقاد قرارداد بر اساس فهرست بهاء پایه سازمان برنامه و بودجه (تهیه مصالح به عهده:)"
            tools:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValue"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20sdp"
            android:ellipsize="end"
            android:gravity="right"
            android:text='@{item._value}'
            android:textDirection="rtl"
            android:textSize='@{item._isHeader?@dimen/font_header_size:@dimen/font_title_size}'
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="پرداخت های انجام شدپرداخت های انجام شده (ریال)پرداخت های انجام شده (ریال)پرداخت های انجام شده (ریال)ه (ریال)" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
