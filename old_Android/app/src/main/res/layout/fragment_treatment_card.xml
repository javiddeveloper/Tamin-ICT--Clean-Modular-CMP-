<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:background="@drawable/bg_gray_treatment">


        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/colorAccent"
            android:elevation="@dimen/_5sdp"
            app:layout_constraintBottom_toTopOf="@+id/tvDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgBarcode"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            tools:text="سعید هنری" />

        <TextView
            android:id="@+id/tvTitleNationalId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:textColor="@color/gray_dark"
            android:textSize="@dimen/font_sub_title_size"
            android:text="@string/national_code"
            app:layout_constraintEnd_toEndOf="@+id/tvName"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <TextView
            android:id="@+id/tvValueNationalId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/font_sub_title_size"
            android:gravity="right"
            app:layout_constraintEnd_toEndOf="@+id/tvTitleNationalId"
            app:layout_constraintStart_toEndOf="@+id/imgBarcode"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleNationalId"
            tools:text="123456789" />

        <TextView
            android:id="@+id/tvTitleInsuranceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/font_sub_title_size"
            android:layout_marginTop="@dimen/_5sdp"
            android:textColor="@color/gray_dark"
            android:text="@string/insurance_num"
            app:layout_constraintEnd_toEndOf="@+id/tvName"
            app:layout_constraintTop_toBottomOf="@+id/tvValueNationalId" />

        <TextView
            android:id="@+id/tvValueInsuranceId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/font_sub_title_size"
            android:gravity="right"
            android:textColor="@color/text_color_orange"
            app:layout_constraintEnd_toEndOf="@+id/tvTitleNationalId"
            app:layout_constraintStart_toEndOf="@+id/imgBarcode"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleInsuranceId"
            tools:text="123456789" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgBarcode"
            android:layout_width="@dimen/_47sdp"
            android:layout_height="@dimen/_47sdp"
            android:layout_gravity="center_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvName"
            tools:background="@color/lineColor" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_eligibility_status_by_value"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@id/txt_deserve_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icTreatmentStatus"
            app:layout_constraintTop_toTopOf="@+id/guideline5"
            app:layout_constraintVertical_chainStyle="spread" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icTreatmentStatus"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginEnd="@dimen/_5sdp"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/tvDesc"
            app:layout_constraintEnd_toStartOf="@+id/tvDesc"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvTreatmentStatus"
            app:layout_constraintTop_toTopOf="@+id/tvDesc"
            tools:background="@color/lineColor" />

        <TextView
            android:id="@+id/tvTreatmentStatus"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:gravity="right"
            android:text="@string/label_eligibility_status"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/tvDesc"
            app:layout_constraintEnd_toStartOf="@+id/icTreatmentStatus"
            app:layout_constraintHorizontal_bias="0.86"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvDesc"
            app:layout_constraintVertical_bias="0.93" />

        <TextView
            android:id="@+id/txt_deserve_description"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:textColor="@color/white"
            android:lines="1"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tvDesc"
            app:layout_constraintStart_toEndOf="@+id/btn_show_description"
            app:layout_constraintTop_toBottomOf="@+id/tvDesc"
            tools:text="TextView" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_description"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/show_detail"
            android:textSize="@dimen/font_sub_title_size"
            app:layout_constraintBaseline_toBaselineOf="@+id/txt_deserve_description"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.81" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
