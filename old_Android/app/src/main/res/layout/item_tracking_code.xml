<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_workshop_code">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTrackingCodeTitle"
        style="@style/TextStyle.SubTitle"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/margin_5dp"
        android:gravity="center"
        android:paddingStart="@dimen/margin_5dp"
        android:paddingLeft="@dimen/margin_10dp"
        android:paddingEnd="@dimen/margin_10dp"
        android:paddingRight="@dimen/margin_10dp"
        android:paddingBottom="@dimen/margin_2dp"
        android:text="@string/tracking_code"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvTrackingCodeValue"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTrackingCodeValue"
        style="@style/TextStyle.SubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_marginBottom="@dimen/margin_5dp"
        android:gravity="center"
        android:maxHeight="@dimen/dimen_60dp"
        android:paddingStart="@dimen/margin_10dp"
        android:paddingLeft="@dimen/margin_10dp"
        android:paddingEnd="@dimen/margin_5dp"
        android:paddingRight="@dimen/margin_10dp"
        android:paddingBottom="@dimen/margin_2dp"
        android:text="0495554"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvTrackingCodeTitle"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
