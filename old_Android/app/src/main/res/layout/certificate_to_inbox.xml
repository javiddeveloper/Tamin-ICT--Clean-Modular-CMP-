<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:layoutDirection="rtl">

    <View
        android:id="@+id/view"
        android:layout_width="30dp"
        android:layout_height="4dp"
        android:layout_margin="@dimen/margin_10dp"
        android:background="#dadce0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tamin.taminhamrah.widget.edittext.SelectableItemView
        android:id="@+id/selectBranch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_20dp"
        app:editText_hint="@string/label_branch_name_bank"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view" />

    <com.tamin.taminhamrah.widget.edittext.string.EditTextString
        android:id="@+id/interBranchName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_20dp"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_10dp"
        app:editText_hint="@string/label_name_receiving_branch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectBranch"
        app:type="place_name" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSenCertificateToInbox"
        style="@style/MainButton"
        android:layout_margin="@dimen/margin_20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/margin_50dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:text="@string/send_to_inbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/interBranchName" />


</androidx.constraintlayout.widget.ConstraintLayout>

