<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.home.services.employer.correspondence.correspondenceReport.CorrespondenceViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true">

        <include
            android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />


        <RelativeLayout
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"

            android:clickable="false"
            android:nestedScrollingEnabled="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <View
                android:id="@+id/viewTotalSpace"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/margin_30dp"
                android:layout_marginStart="@dimen/margin_30dp"
                android:layout_marginEnd="@dimen/margin_30dp"
                android:layout_marginBottom="@dimen/margin_10dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentLeft="true"
                android:background="@drawable/bg_grey"
                android:nestedScrollingEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/viewUsageSpace"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_green"
                android:layout_alignBottom="@+id/viewTotalSpace"
                android:layout_alignTop="@+id/viewTotalSpace"
                android:layout_alignStart="@+id/viewTotalSpace"
                app:layout_constraintBottom_toBottomOf="@id/viewTotalSpace"
                app:layout_constraintStart_toStartOf="@id/viewTotalSpace"
                app:layout_constraintTop_toTopOf="@id/viewTotalSpace" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalSpace"
                style="@style/TextStyle.SubTitle"
                android:layout_below="@+id/viewTotalSpace"
                android:layout_alignEnd="@+id/viewTotalSpace"
                android:gravity="end"
                android:text='@{viewModel.mldCorrespondenceSize.total + " "+ @string/label_mega_byte}'
                app:layout_constraintEnd_toEndOf="@id/viewTotalSpace"
                app:layout_constraintStart_toEndOf="@id/tvCurrentSpace"
                app:layout_constraintTop_toBottomOf="@id/viewTotalSpace"
                tools:text='sadasd' />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCurrentSpace"
                style="@style/TextStyle.SubTitle"
                android:layout_below="@+id/viewTotalSpace"
                android:layout_alignStart="@+id/viewTotalSpace"
                android:text='@{viewModel.mldCorrespondenceSize.usage + " "+ @string/label_mega_byte}'
                app:layout_constraintEnd_toStartOf="@id/tvTotalSpace"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="@id/viewTotalSpace"
                app:layout_constraintTop_toBottomOf="@id/viewTotalSpace"
                tools:text='sadasd' />

            <com.tamin.taminhamrah.widget.CustomRecyclerView
                android:id="@+id/recycler"
                style="@style/LinearPaginationRecyclerStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_below="@+id/tvCurrentSpace"
                app:layout_constraintTop_toBottomOf="@+id/tvCurrentSpace" />



        </RelativeLayout>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
