<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>

    </data>

<com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView
    style="@style/VerticalStepperItemView"
    android:id="@+id/stepperItem"
    app:step_state="selected"
    app:nextStepEnable="true"
    app:previousStepVisible="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelInsuranceNum"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:ellipsize="end"
            android:gravity="start"
            android:text="@string/label_insurance_number"
            app:layout_constraintBottom_toTopOf="@id/line2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/valueInsuranceNum"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/valueInsuranceNum"
            style="@style/TextStyle.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            app:layout_constraintBottom_toBottomOf="@id/labelInsuranceNum"
            app:layout_constraintEnd_toStartOf="@+id/labelInsuranceNum"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelInsuranceNum"
            tools:text="2324234234" />

        <View
            android:id="@+id/line2"
            android:layout_width="0dp"
            android:layout_height="@dimen/line_height"
            android:background="@color/lineColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/margin_10dp"
            app:layout_constraintTop_toBottomOf="@id/labelInsuranceNum" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/valueBranchInfo"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:ellipsize="end"
            android:gravity="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/labelBranchTitle"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="@+id/valueInsuranceNum"
            app:layout_constraintTop_toTopOf="@id/labelBranchTitle"
            tools:text="یبتابستبایب تسایابسنبتاستسایابسنبتاستسایابسنبتاستسایابسنبتاستسایابسنبتاستسایابسنبتاستسایابسنبتاس " />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelBranchTitle"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10dp"
            android:layout_marginBottom="@dimen/margin_10dp"
            android:layout_marginStart="@dimen/margin_10dp"
            android:ellipsize="end"
            android:gravity="start"
            android:text="@string/label_branch_selected"

            app:layout_constraintEnd_toEndOf="@+id/labelInsuranceNum"
            app:layout_constraintStart_toEndOf="@id/valueBranchInfo"
            app:layout_constraintTop_toBottomOf="@id/line2" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView>
</layout>