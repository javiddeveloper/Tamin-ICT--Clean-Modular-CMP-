<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:minWidth="@dimen/dialog_min_width">

    <View
        android:id="@+id/view"
        android:layout_width="30dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/margin_10dp"
        android:background="#dadce0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/labelTitle"
        style="@style/TextStyle.Title"
        tools:text="انتخاب عکس اول شناسنامه از :"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        android:layout_marginStart="@dimen/margin_20dp"
        app:layout_constraintBottom_toTopOf="@id/btnCamera"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnCamera"
        style="@style/ImageButton.Clickable"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnGallery"
        app:srcCompat="@drawable/ic_add_from_camera"
        android:tint="@android:color/white"
        android:background="@drawable/bg_oval_accent"
        android:backgroundTint="?colorPrimary"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/labelCamera"
        style="@style/TextStyle.Title"
        android:text="@string/lable_camera"
        app:layout_constraintEnd_toEndOf="@id/btnCamera"
        app:layout_constraintStart_toStartOf="@id/btnCamera"
        app:layout_constraintTop_toBottomOf="@id/btnCamera"
        android:layout_marginTop="6dp"
        />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnGallery"
        style="@style/ImageButton.Clickable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnCamera"
        app:layout_constraintBottom_toBottomOf="@id/btnCamera"
        app:srcCompat="@drawable/ic_add_from_gallery"
        android:background="@drawable/bg_oval_accent"
        android:backgroundTint="?colorAccent"
        android:tint="@android:color/white"
        app:layout_constraintStart_toEndOf="@id/btnCamera"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/labelGallery"
        style="@style/TextStyle.Title"
        android:text="@string/lable_gallery"
        app:layout_constraintEnd_toEndOf="@id/btnGallery"
        app:layout_constraintStart_toStartOf="@id/btnGallery"
        app:layout_constraintTop_toBottomOf="@id/btnGallery"
        android:layout_marginTop="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
