<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="itemInput"
            type="com.tamin.taminhamrah.data.remote.models.services.NotExistRequestsModel" />

        <variable
            name="isEmployer"
            type="Boolean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayoutSpring"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@{isEmployer?@drawable/bg_item_accent:@drawable/bg_item_blue}"
        android:clickable="true"
        android:elevation="@dimen/margin_5dp"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@drawable/bg_item_blue">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/btnDelete"
            app:layout_constraintStart_toEndOf="@+id/titleStatus"
            app:layout_constraintTop_toTopOf="@+id/btnDelete"
            app:srcCompat="@drawable/ic_circle_orange"
            app:tint="@color/bg_dialog_red_light" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/titleStatus"
            style="@style/TextStyle.SubTitle"
            android:gravity="center"
            android:text="@string/title_status_send_request"
            android:visibility="visible"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintStart_toEndOf="@+id/valueStatus"
            app:layout_constraintTop_toTopOf="@+id/imageView2" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/valueStatus"
            style="@style/TextStyle.SubTitle"
            android:gravity="center"
            android:text="@string/label_dont_send_request"
            android:textColor="@color/bg_dialog_red_light"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="@+id/tvValueEndDate"
            app:layout_constraintTop_toTopOf="@+id/titleStatus" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleJob"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/label_branch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueTitleJob"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="@{itemInput.branchName + `_` + ` بیمه ` +itemInput.insuranceTypeDesc}"
            app:layout_constraintBottom_toTopOf="@id/line1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_insurance_code"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleJob"
            tools:text="13 تهران" />

        <include
            android:id="@+id/item_insurance_code"
            layout="@layout/item_insurance_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:maxWidth="@dimen/margin_10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvValueTitleJob"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitleJob" />

        <View
            android:id="@+id/line1"
            android:layout_width="0dp"
            android:layout_height="@dimen/line_height"
            android:layout_marginTop="@dimen/margin_10dp"
            android:background="@color/lineColor"
            app:layout_goneMarginTop="@dimen/_5sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvValueTitleJob" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleWorkShop"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/label_workshop_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueWorkShop"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:text="@{itemInput.rwshname}"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/margin_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/item_workshop_code"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleWorkShop"
            tools:text="خدمات ماشینی تأمین" />

        <include
            android:id="@+id/item_workshop_code"
            layout="@layout/item_workshop_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_20dp"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/tvValueWorkShop"
            app:layout_constraintTop_toTopOf="@id/tvTitleWorkShop" />

        <View
            android:id="@+id/line2"
            android:layout_width="0dp"
            android:layout_height="@dimen/line_height"
            android:layout_marginTop="@dimen/margin_10dp"
            android:background="@color/lineColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvValueWorkShop" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleStartDate"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:text="@string/label_start_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line2" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueStartDate"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:gravity="center"
            android:text="1399/07"
            app:layout_constraintEnd_toEndOf="@+id/tvTitleStartDate"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleStartDate" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleEndDate"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:text="@string/label_end_date"
            app:layout_constraintStart_toStartOf="@+id/tvValueEndDate"
            app:layout_constraintTop_toTopOf="@+id/tvTitleStartDate" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueEndDate"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:gravity="center"
            android:text="1399/07"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleEndDate" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEdit"
            style="@style/TextButtonBordered.Grey"
            android:layout_width="@dimen/margin_80dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:layout_marginBottom="@dimen/margin_20dp"
            android:text="@string/edit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvValueStartDate" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDelete"
            style="@style/TextButtonBordered.Red"
            android:layout_width="@dimen/margin_80dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:layout_marginBottom="@dimen/margin_20dp"
            android:text="@string/label_delete"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnEdit"
            app:layout_constraintTop_toBottomOf="@+id/tvValueEndDate" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
