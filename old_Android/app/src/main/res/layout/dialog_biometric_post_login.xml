<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="@dimen/dialog_min_width"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/margin_20dp">

        <!-- Title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelTitle"
            style="@style/TextStyle.Title.Bold"
            android:layout_marginTop="@dimen/margin_20dp"
            android:layout_marginHorizontal="@dimen/margin_20dp"
            android:gravity="center"
            android:text="@string/biometric_dialog_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle / description under title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBiometricSubtitle"
            style="@style/TextStyle.Title"
            android:layout_marginTop="@dimen/margin_12dp"
            android:layout_marginHorizontal="@dimen/margin_20dp"
            android:justificationMode="inter_word"
            android:text="@string/biometric_login_subtitle"
            app:layout_constraintTop_toBottomOf="@id/labelTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="@dimen/line_height"
            android:layout_marginTop="@dimen/margin_16dp"
            android:background="@color/lineColor"
            app:layout_constraintTop_toBottomOf="@id/tvBiometricSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Biometric row -->
        <LinearLayout
            android:id="@+id/layoutBiometricRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_20dp"
            android:paddingVertical="@dimen/margin_12dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Switch
                android:id="@+id/switchBiometric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/AppThemeSwitch"
                android:layout_marginEnd="@dimen/margin_12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBiometricTitle"
                    style="@style/TextStyle.Title"
                    android:text="@string/biometric_login_title"
                    android:textAlignment="viewEnd" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDescription"
                    style="@style/TextStyle.SubTitle"
                    android:layout_marginTop="@dimen/margin_6dp"
                    android:text="@string/biometric_dialog_desc"
                    android:textAlignment="viewEnd" />
            </LinearLayout>

        </LinearLayout>

        <!-- Hint -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/biometricHint"
            style="@style/TextStyle.SubTitle"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginHorizontal="@dimen/margin_20dp"
            android:text="@string/No_Bio"
            android:textColor="@color/design_default_color_error"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layoutBiometricRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Buttons -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirm"
            style="@style/TextButtonBordered.Blue"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:layout_marginEnd="@dimen/margin_20dp"
            android:text="@string/confirm"
            app:layout_constraintTop_toBottomOf="@id/biometricHint"
            app:layout_constraintStart_toEndOf="@id/btnCancel"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            style="@style/TextButtonBordered.Grey"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:layout_marginStart="@dimen/margin_20dp"
            android:text="@string/cancel"
            app:layout_constraintTop_toTopOf="@id/biometricHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnConfirm" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
