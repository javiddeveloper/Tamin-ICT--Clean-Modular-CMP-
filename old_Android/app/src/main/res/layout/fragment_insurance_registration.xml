<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.home.services.insuranceRegistration.InsuranceRegistrationViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true">

        <include
            android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <include
                    android:id="@+id/inputInsuranceType"
                    layout="@layout/widget_selectable_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_20dp"
                    app:hintselect="@{@string/label_insurance_type}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <include
                    android:id="@+id/inputCityOfBirth"
                    layout="@layout/widget_selectable_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    app:hintselect="@{@string/birth_city}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputInsuranceType" />

                <include
                    android:id="@+id/inputCityIssuance"
                    layout="@layout/widget_selectable_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    app:hintselect="@{@string/issue_city}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inputCityOfBirth" />

                <include
                    android:id="@+id/inputBranch"
                    layout="@layout/widget_selectable_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    app:hintselect="@{@string/label_branch_name}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputCityIssuance"/>

                <View
                    android:id="@+id/view3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:background="@drawable/bg_left_corner_rounded_grey_with_white_adge"
                    app:layout_constraintBottom_toTopOf="@id/view4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputBranch" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelImageRequest"
                    style="@style/TextStyle.Title.Bold"
                    android:padding="@dimen/margin_20dp"
                    android:text="@string/label_image_request"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/view3" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_Desc_1"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:text="@string/label_select_image_for_registration"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/labelImageRequest" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHasNationalCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:checked="true"
                    android:fontFamily="@font/iran_sans_mobile_fa_num"
                    android:layoutDirection="rtl"
                    android:text="@string/label_has_national_card"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/item_Desc_1" />

                <com.tamin.taminhamrah.widget.edittext.string.EditTextString
                    android:id="@+id/inputSerialNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    app:editText_hint="@string/hint_nationl_code_serial_number"
                    app:editText_max_len="10"
                    app:layout_constraintBottom_toTopOf="@id/labelCommitment"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/swHasNationalCard"
                    app:type="english_input"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/layoutUploadImage"
                    layout="@layout/view_image_picker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/view4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/swHasNationalCard"
                    tools:layout_height="100dp"
                    tools:visibility="visible" />

                <View
                    android:id="@+id/view4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:background="@drawable/bg_left_corner_rounded_white_with_grey_adge"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view3" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelCommitment"
                    style="@style/TextStyle.Title.Bold"
                    android:padding="@dimen/margin_20dp"
                    android:text="@string/label_commitment"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/view4" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelRegistrationCommitmentDesc"
                    style="@style/TextStyle.Title"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:text="@string/label_registration_commitment_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/labelCommitment" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOk"
                    style="@style/MainButton"
                    android:layout_width="0dp"
                    android:layout_margin="@dimen/margin_20dp"
                    android:text="@string/ok_and_continua"
                    app:layout_constraintBottom_toBottomOf="@id/view4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/labelRegistrationCommitmentDesc" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>

