<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.splash.SplashViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:textDirection="rtl"
        android:fitsSystemWindows="true"
        android:theme="@style/AppTheme"
        tools:context=".ui.activity.splash.SplashActivity">


       <!-- <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:lottie_autoPlay="true"
            app:lottie_fileName="splash_old.json"
            app:lottie_loop="false"
            android:adjustViewBounds="true"
            />
-->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logoApp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_bg" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_logo_tamin" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAppName"
            style="@style/TextStyle.Title.Bold"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:text="@string/app_name"
            android:gravity="center"
            android:textColor="@color/green_font"
            app:layout_constraintBottom_toTopOf="@id/tvRelease"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRelease"
            style="@style/TextStyle.Title.Bold"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:text="@string/release"
            android:gravity="center"
            android:textStyle="normal"
            android:textSize="12sp"
            android:textColor="@color/green_font"
            app:layout_constraintBottom_toTopOf="@id/tvAppVersion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextStyle.Title"
            android:id="@+id/tvAppVersion"
            android:layout_marginBottom="@dimen/margin_30dp"
            android:text="@string/version_app"
            android:textColor="@color/green_font"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/tvTestVersion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextStyle.SubTitle"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:id="@+id/tvTestVersion"
            android:background="@drawable/bg_btn_dialog_dark_blue"
            android:paddingStart="@dimen/margin_10dp"
            android:paddingEnd="@dimen/margin_10dp"
            android:paddingTop="@dimen/margin_4dp"
            android:paddingBottom="@dimen/margin_4dp"
            android:backgroundTint="@color/amber"
            android:layout_marginBottom="@dimen/margin_30dp"
            android:text="@string/label_test_version"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>