<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    
    <com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView
        android:id="@+id/stepperDesc"
        style="@style/VerticalStepperItemView"
        app:nextStepTitle="@string/label_register_objection"
        app:step_index="3"
        app:step_state="normal"
        tools:step_state="selected"
        app:nextStepEnable="false"
        app:step_title="@string/label_register_objection">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
           >
            <com.tamin.taminhamrah.widget.edittext.string.MultiLineEditTextString
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:editText_hint="@string/label_objection_description"
                android:layout_marginTop="@dimen/margin_10dp"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView>
</layout>
