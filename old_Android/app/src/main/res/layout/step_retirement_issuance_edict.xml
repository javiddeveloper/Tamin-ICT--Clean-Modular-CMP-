<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView
        style="@style/VerticalStepperItemView"
        android:id="@+id/issuanceEdictStepper"
        app:step_state="normal"
        tools:step_state="selected"
        app:step_index="9"
        app:nextStepVisible="false"
        app:previousStepVisible="false"
        app:step_title="@string/issuance_edict_retirement_step"
        app:nextStepEnable="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingBottom="@dimen/_20sdp"
               >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgDeskIssuanceEdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvDescIssuanceEdict"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_info_outline"
                    android:tint="@color/text_color_dialog_blue"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDescIssuanceEdict"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="0dp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginEnd="@dimen/margin_5dp"
                    android:justificationMode="inter_word"
                    android:text="@string/issuance_edict_confirmed"
                    app:layout_constraintEnd_toStartOf="@+id/imgDeskIssuanceEdict"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/imgDeskIssuanceEdict"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
    </com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView>
</layout>