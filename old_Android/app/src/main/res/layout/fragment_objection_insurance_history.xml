<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"

        android:fitsSystemWindows="true">

        <include android:id="@+id/appBar"
            layout="@layout/view_appbar_service"
            />
        <include android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:background="?attr/colorSurface">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelDetailRecords"
                    style="@style/TextStyle.Title"
                    android:layout_marginTop="@dimen/margin_24dp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="@string/label_details_records"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelDetailRecordsDesc"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:text="@string/label_details_objection_history_desc"
                    app:layout_constraintTop_toBottomOf="@+id/labelDetailRecords" />


                <com.tamin.taminhamrah.widget.CustomRecyclerView
                    android:id="@+id/recycler"
                    style="@style/LinearPaginationRecyclerStyle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    app:decoration_type="grid_3_col"
                    app:layout_constraintTop_toBottomOf="@+id/labelDetailRecordsDesc" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelEditedWorkShop"
                    style="@style/TextStyle.Title"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="@string/label_edited_workshop_year"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recycler"  />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEditedHisories"
                    style="@style/LinearRecyclerStyle"
                    android:layout_width="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:fillViewport="true"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    app:layout_constraintTop_toBottomOf="@+id/labelEditedWorkShop" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupEditedHisories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:visibility="visible"
                    android:visibility="gone"
                    app:constraint_referenced_ids="recyclerEditedHisories,labelEditedWorkShop"
                    />


                <com.tamin.taminhamrah.widget.edittext.string.MultiLineEditTextString
                    android:id="@+id/inputDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    app:editText_hint="@string/label_description"
                    app:layout_constraintTop_toBottomOf="@+id/recyclerEditedHisories" />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendReq"
                    style="@style/MainButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:text="@string/label_ok_and_send"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputDescription" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>


