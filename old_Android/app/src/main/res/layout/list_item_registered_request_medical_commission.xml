<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="dataModel"
            type="com.tamin.taminhamrah.data.remote.models.services.disabilityPension.medicalCommission.RegisteredMedicalCommissionModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_blue"
        android:elevation="2dp"
        android:paddingBottom="@dimen/_10sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleTracingNum"
            style="@style/TextStyle.SubTitle"
            android:layout_margin="@dimen/_10sdp"
            android:text="@string/tracing_num"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueTracingNum"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:ellipsize="end"
            android:gravity="right|center_vertical"
            android:textColor="@color/colorPrimary"
            android:text="@{dataModel.refId}"
            app:layout_constraintBottom_toBottomOf="@+id/tvValueRegistrationDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvValueRegistrationDate"
            app:layout_constraintTop_toTopOf="@+id/tvValueRegistrationDate"
            tools:text="234234234" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleRegistrationDate"
            style="@style/TextStyle.SubTitle"
            android:layout_margin="@dimen/_10sdp"
            android:text="@string/registration_date"
            app:layout_constraintEnd_toStartOf="@+id/tvValueTracingNum"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueRegistrationDate"
            style="@style/TextStyle.Title"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/bg_btn_orange_light"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/tvValueTracingNum"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitleRegistrationDate"
            tools:text="@{dataModel.getPersianDate()}" />

        <View
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@color/lineColor"
            app:layout_constraintTop_toBottomOf="@id/tvValueTracingNum" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            style="@style/LinearRecyclerStyle"
            android:layout_width="match_parent"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/line1" />

        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/lineColor"
            app:layout_constraintTop_toBottomOf="@id/recycler" />


  <!--      <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAction"
            style="@style/TextButtonBordered.ActionButton"
            android:layout_width="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/label_actions"
            android:textSize="@dimen/font_sub_title_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnShowDetail"
            app:layout_constraintTop_toBottomOf="@+id/line2" />
-->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShowDetail"
            style="@style/TextButton"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="@string/show_detail"
            android:textSize="@dimen/font_sub_title_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recycler" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
