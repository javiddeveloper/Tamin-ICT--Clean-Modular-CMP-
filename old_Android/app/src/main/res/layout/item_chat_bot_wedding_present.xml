<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_chat_bot_clickable"
    android:padding="16dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnCancel"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cancel"
        android:padding="4dp"
        android:tint="@color/material_grey_500"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_outline" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_request_marriage_gift"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <View
            android:id="@+id/step4"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_circle_grey" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="3dp"
            android:background="@color/grey_color_text_button_bordered" />

        <View
            android:id="@+id/step3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_circle_grey" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="3dp"
            android:background="@color/grey_color_text_button_bordered" />

        <View
            android:id="@+id/step2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_circle_grey" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="3dp"
            android:background="@color/grey_color_text_button_bordered" />

        <View
            android:id="@+id/step1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_circle_blue" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_steps"
        tools:visibility="visible" />

    <!-- Step 1: getNoPresenceLoadData + form -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/groupStep1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_steps">

        <TextView
            android:id="@+id/tvUserInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="شماره بیمه: 123456" />

        <com.tamin.taminhamrah.widget.DatePickerWidget
            android:id="@+id/widgetDatePickerWeddingGift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:date_piker_hint="@string/label_contract_date"
            app:layout_constraintTop_toBottomOf="@id/tvUserInfo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPartnerNationalCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/national_code_partner"
            app:layout_constraintTop_toBottomOf="@id/widgetDatePickerWeddingGift">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPartnerNationalCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvCommitment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:text="@string/label_commitment_desc"
            android:textColor="@color/material_grey_500"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/checkboxCommitment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilPartnerNationalCode" />

        <CheckBox
            android:id="@+id/checkboxCommitment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/tvCommitment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvCommitment"
            app:layout_constraintTop_toTopOf="@id/tvCommitment" />

        <TextView
            android:id="@+id/tvStep1Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/red_recycler_color_icon"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvCommitment"
            tools:text="اطلاعات ازدواج شما در سامانه ی ثبت احوال ثبت نگردیده است"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/material_blue_500"
            android:text="@string/confirm"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStep1Error" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Step 2: validateMariageNoPresence result -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/groupStep2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_steps">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgValidateStatus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_check_circle_green" />

        <TextView
            android:id="@+id/tvValidateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/green_dark"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/imgValidateStatus"
            tools:text="اعتبارسنجی تاریخ عقد با موفقیت انجام شد" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedToCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/material_blue_500"
            android:text="@string/label_caculate_wedding_gift"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvValidateMessage" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Step 3: calcMarriage -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/groupStep3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_steps">

        <TextView
            android:id="@+id/labelDetailRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_specifications_marriage"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.tamin.taminhamrah.widget.DatePickerWidget
            android:id="@+id/widgetDatePickerMarriage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:date_piker_hint="@string/label_contract_date"
            app:layout_constraintTop_toBottomOf="@id/labelDetailRecords" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/material_blue_500"
            android:text="@string/label_calculate_marriage_allowance"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/widgetDatePickerMarriage" />

        <TextView
            android:id="@+id/tvCalcError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/red_recycler_color_icon"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnCal"
            tools:text="خطا در محاسبه"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root_layout_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_left_corner_rounded_indigo"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvCalcError"
            tools:visibility="visible">

            <TextView
                android:id="@+id/AmountPayableValueTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/the_amount_wedding_gift"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelAmountPayableRial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ریال"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/AmountPayableValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/AmountPayableValue" />

            <TextView
                android:id="@+id/AmountPayableValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/green_dark"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/AmountPayableValueTitle"
                app:layout_constraintStart_toEndOf="@id/labelAmountPayableRial"
                app:layout_constraintTop_toTopOf="@id/AmountPayableValueTitle"
                tools:text="30,124,325" />

            <TextView
                android:id="@+id/SumSalaryLastTwoYearsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sum_salary_last_two_years"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/AmountPayableValueTitle" />

            <TextView
                android:id="@+id/labelSumSalaryLastTwoYearsTitleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ریال"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/SumSalaryLastTwoYearsTitleValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/SumSalaryLastTwoYearsTitleValue" />

            <TextView
                android:id="@+id/SumSalaryLastTwoYearsTitleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/SumSalaryLastTwoYearsTitle"
                app:layout_constraintStart_toEndOf="@id/labelSumSalaryLastTwoYearsTitleValue"
                app:layout_constraintTop_toTopOf="@id/SumSalaryLastTwoYearsTitle"
                tools:text="200,123,658" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceedToSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/material_blue_500"
            android:text="@string/label_submit_commitment"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/root_layout_result" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Step 4: saveShorttremMariage + success -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/groupStep4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_steps">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgSubmitStatus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_check_circle_green"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvSubmitMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/green_dark"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/imgSubmitStatus"
            tools:text="درخواست با موفقیت ثبت شد"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/material_blue_500"
            android:text="@string/label_submit_commitment"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
