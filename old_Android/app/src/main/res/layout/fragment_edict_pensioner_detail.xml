<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?attr/colorSurface">

        <include android:id="@+id/appBar"
            layout="@layout/view_appbar_service_info_edict"/>

        <include android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_20sdp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/labelInfoEdict"
                        style="@style/TextStyle.Title.Bold"
                        android:layout_width="wrap_content"
                        android:text="@string/info_edict"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/btnInfoEdictExpand"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/btnInfoEdictExpand" />


                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnInfoEdictExpand"
                    style="@style/ImageButton.Clickable"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:background="@drawable/ic_expand_more" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelOrgHistory"
                    style="@style/TextStyle.Title"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:text="@string/org_history"
                    app:layout_constraintBottom_toBottomOf="@+id/valueDays"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/valueDays" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/valueDays"
                    style="@style/TextStyle.Title"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnInfoEdictExpand"
                    android:layout_marginTop="@dimen/_10sdp"
                    tools:text="1 سال و 6 ماه و 2 روز" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/line_height"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@color/lineColor"
                    app:layout_constraintTop_toBottomOf="@+id/valueDays" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvInfoEdict"
                        style="@style/LinearRecyclerStyle"
                        android:layout_width="match_parent"
                        app:layout_constraintTop_toBottomOf="@+id/line1" />


                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnInfoWageBeforeIncreaseExpand"
                    style="@style/ImageButton.Clickable"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rcvInfoEdict"
                    android:background="@drawable/ic_expand_more" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/labelInfoWageBeforeIncrease"
                        style="@style/TextStyle.Title.Bold"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:text="@string/info_wage_before_increase"
                        app:layout_constraintBottom_toBottomOf="@+id/btnInfoWageBeforeIncreaseExpand"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/btnInfoWageBeforeIncreaseExpand" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/AmountWageBeforeIncreaseValue"
                        style="@style/TextStyle.SubTitle.Orange"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/labelInfoWageBeforeIncrease"
                        app:layout_constraintStart_toEndOf="@+id/labelRial1"
                        tools:text="30,124,325" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/labelRial1"
                        style="@style/TextStyle.SubTitle"
                        android:layout_width="wrap_content"
                        android:text="@string/rial"
                        app:layout_constraintBottom_toBottomOf="@+id/AmountWageBeforeIncreaseValue"
                        app:layout_constraintStart_toEndOf="@+id/btnInfoWageBeforeIncreaseExpand"
                        app:layout_constraintTop_toTopOf="@+id/AmountWageBeforeIncreaseValue" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvInfoWageBeforeIncrease"
                        style="@style/LinearRecyclerStyle"
                        android:layout_width="match_parent"
                        app:layout_constraintTop_toBottomOf="@+id/btnInfoWageBeforeIncreaseExpand" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnInfoInfoWageAfterIncreaseExpand"
                    style="@style/ImageButton.Clickable"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rcvInfoWageBeforeIncrease"
                    android:background ="@drawable/ic_expand_more" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelInfoWageAfterIncrease"
                    style="@style/TextStyle.Title.Bold"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="@string/info_wage_after_increase"
                    app:layout_constraintBottom_toBottomOf="@+id/btnInfoInfoWageAfterIncreaseExpand"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/btnInfoInfoWageAfterIncreaseExpand" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/AmountWageAfterIncreaseValue"
                    style="@style/TextStyle.SubTitle.Green"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/labelInfoWageAfterIncrease"
                    app:layout_constraintStart_toEndOf="@+id/labelRial2"
                    tools:text="30,124,325" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelRial2"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="wrap_content"
                    android:text="@string/rial"
                    app:layout_constraintBottom_toBottomOf="@+id/AmountWageAfterIncreaseValue"
                    app:layout_constraintStart_toEndOf="@+id/btnInfoInfoWageAfterIncreaseExpand"
                    app:layout_constraintTop_toTopOf="@+id/AmountWageAfterIncreaseValue" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvInfoWageAfterIncrease"
                    style="@style/LinearRecyclerStyle"
                    android:layout_width="match_parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnInfoInfoWageAfterIncreaseExpand" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSendToInbox"
            style="@style/MainButton"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/send_to_inbox"
            android:textSize="@dimen/font_size_12"
            android:layout_gravity="bottom" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>