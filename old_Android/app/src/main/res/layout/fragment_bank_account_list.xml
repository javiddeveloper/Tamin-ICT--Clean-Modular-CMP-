<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
       android:background="?attr/colorSurface"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true">

        <include android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />

      <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              >


              <androidx.appcompat.widget.AppCompatButton
                  android:id="@+id/btnNewAccount"
                  style="@style/TextButtonBordered.Green"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="parent"
                  android:layout_margin="@dimen/margin_20dp"
                  app:layout_constraintBottom_toTopOf="@id/recyclerList"
                  android:text="@string/label_create_new_account"
                  android:drawableEnd="@drawable/ic_add"

                  />
              <com.tamin.taminhamrah.widget.CustomRecyclerView
                  android:id="@+id/recyclerList"
                  style="@style/LinearPaginationRecyclerStyle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"

                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toBottomOf="@id/btnNewAccount" />

          </androidx.constraintlayout.widget.ConstraintLayout>


      <!--  <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            style="@style/LinearRecyclerStyle"
             />-->



       </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    </layout>

