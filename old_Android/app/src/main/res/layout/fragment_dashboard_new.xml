<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:theme="@style/AppTheme"
    tools:context=".ui.home.dashboard.DashboardFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:animateLayoutChanges="true"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent">


        <!--  <com.tamin.taminhamrah.widget.CustomSearchView
              android:id="@+id/searchView"
              style="@style/SearchView"
              android:layout_marginStart="@dimen/margin_20dp"
              android:layout_marginEnd="@dimen/margin_20dp"
              android:layout_marginBottom="@dimen/margin_20dp"
              android:visibility="gone"
              app:layout_constraintBottom_toTopOf="@id/nesteddScrollView"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/toolbar"
              app:queryHint="@string/label_search" />
-->
        <include
            android:id="@+id/toolbar"
            layout="@layout/view_toolbar_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_collapseMode="parallax" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appBarView"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:paddingBottom="@dimen/_100sdp"
        android:theme="@style/AppTheme"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toBottomOf="@id/appBarView" />

    <!--        <include-->
    <!--            android:id="@+id/viewRetry"-->
    <!--            layout="@layout/view_retry"-->
    <!--            android:layout_width="wrap_content"-->
    <!--            android:layout_height="wrap_content"-->
    <!--            android:layout_centerInParent="true"/>-->


    <com.leinardi.android.speeddial.SpeedDialOverlayLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="close_speed_dial_menu"
        app:clickable_overlay="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.leinardi.android.speeddial.SpeedDialView
        android:id="@+id/speedDialView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        app:layout_behavior="@string/speeddial_scrolling_view_snackbar_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:sdExpansionMode="top"
        app:sdMainFabAnimationRotateAngle="90"
        app:sdMainFabClosedBackgroundColor="?attr/colorPrimary"
        app:sdMainFabClosedIconColor="@android:color/white"
        app:sdMainFabClosedSrc="@drawable/ic_more_horizontal"
        app:sdMainFabOpenedIconColor="@android:color/white"
        app:sdMainFabOpenedSrc="@drawable/ic_close_red"
        app:sdOverlayLayout="@id/overlay" />

    <ImageView
        android:id="@+id/fab_law_ai"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/ic_direct"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

