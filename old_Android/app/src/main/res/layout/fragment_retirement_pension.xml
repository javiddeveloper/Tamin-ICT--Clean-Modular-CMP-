<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:focusable="true"

        android:id="@+id/rootLayout"
        android:fitsSystemWindows="true"
        >

        <include
            android:id="@+id/appbar"
            layout="@layout/view_appbar_service"/>

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_15sdp">

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/grHistoryInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:constraint_referenced_ids="tvAvgSalary,tvValueAvgSalary,tvValueAmountPension,tvAmountPension,stepperLayout"
                    />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/layoutRequestInfo"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    >

                <TextView
                    android:id="@+id/tvTitleRequestInfo"
                    style="@style/TextStyle.Title.Bold"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:text="@string/retirement_request_info_title"
                    android:layout_gravity="end"
               />

                <TextView
                    android:id="@+id/tvTitleIdentityInfo"
                    style="@style/TextStyle.Title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="@string/identity_info"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitleRequestInfo"
                    android:layout_gravity="end"
                    />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/identityInfoRecycler"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_10sdp"
                    style="@style/LinearRecyclerStyle"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitleIdentityInfo" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:id="@+id/backgroundView"
                    app:layout_constraintTop_toTopOf="@+id/tvTitleAddressInfo"
                    app:layout_constraintBottom_toBottomOf="@+id/workshopInfoRecycler"
                    android:background="@color/backgroundColor"
                    />
                <TextView
                    android:id="@+id/tvTitleAddressInfo"
                    style="@style/TextStyle.Title"
                    android:layout_margin="@dimen/_10sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:text="@string/workshop_and_home_info"
                    android:layout_gravity="end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/identityInfoRecycler" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/workshopInfoRecycler"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/actionBarSize"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitleAddressInfo"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:id="@+id/tvAvgSalary"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="@string/avg_salary_last_two_years_rials"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvAmountPension"
                    app:layout_constraintTop_toBottomOf="@+id/layoutRequestInfo"
                    app:layout_constraintWidth_percent="0.4" />

                <TextView
                    android:id="@+id/tvValueAvgSalary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/bg_textview_color"
                    android:backgroundTint="@color/colorPrimary"
                    android:gravity="center"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="@+id/tvAvgSalary"
                    app:layout_constraintStart_toEndOf="@+id/tvValueAmountPension"
                    app:layout_constraintTop_toBottomOf="@+id/tvAvgSalary"
                    app:layout_constraintWidth_percent="0.4"
                    tools:text="17.37" />

                <TextView
                    android:id="@+id/tvAmountPension"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/amount_pension_rial"
                    app:layout_constraintEnd_toStartOf="@+id/tvAvgSalary"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvAvgSalary"
                    app:layout_constraintWidth_percent="0.4" />

                <TextView
                    android:id="@+id/tvValueAmountPension"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/bg_textview_color"
                    android:backgroundTint="@color/bg_summer"
                    android:gravity="center"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toStartOf="@+id/tvValueAvgSalary"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="@+id/tvAmountPension"
                    app:layout_constraintTop_toBottomOf="@+id/tvAmountPension"
                    app:layout_constraintWidth_percent="0.4"
                    tools:text="17.37" />

                <com.tamin.taminhamrah.utils.stepperView.StepperLayout
                    android:id="@+id/stepperLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"

                    app:layout_constraintTop_toBottomOf="@+id/tvValueAmountPension" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
