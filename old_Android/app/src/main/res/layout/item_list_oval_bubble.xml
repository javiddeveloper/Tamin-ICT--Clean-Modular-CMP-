<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/bg_workshop_code">
        
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValue"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:gravity="center"
            android:paddingBottom="@dimen/margin_2dp"
            android:padding="@dimen/margin_5dp"
            android:textColor="@android:color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btnClose"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="aslkd kasj djas djas jd jdlasj kldjas jdlkajs dlkja sk;dja slkjd asl;jd laksj d;las jdlksa jdklas" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClose"
            style="@style/ImageButton"
            android:drawableLeft="@drawable/ic_close_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
