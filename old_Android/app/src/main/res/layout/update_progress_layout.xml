<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="progress"
            type="int" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_dark_blue_top"
        android:minWidth="@dimen/_300sdp">


        <ImageView
            android:id="@+id/imgDownload"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_140sdp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/_4sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_download_update"

            />
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/iran_sans_mobile_fa_num"
            android:text="@string/please_wait"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/_14sdp"
            app:layout_constraintTop_toBottomOf="@+id/imgDownload" />

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/iran_sans_mobile_fa_num"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/_12sdp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/updateProgress"
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_80dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_30sdp"
            android:gravity="center"
            android:progress="@{progress}"
            app:flow_wrapMode="aligned"
            app:layout_constraintEnd_toEndOf="@id/txtDescription"
            app:layout_constraintStart_toStartOf="@id/txtDescription"
            app:layout_constraintTop_toBottomOf="@id/txtDescription"
            app:trackThickness="@dimen/margin_10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelUpdate"
            style="@style/MainButton"
            android:layout_width="@dimen/_100sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/margin_10dp"

            android:layout_marginBottom="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dialog_dark_blue"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/txtDescription"
            app:layout_constraintStart_toStartOf="@id/txtDescription"
            app:layout_constraintTop_toBottomOf="@+id/updateProgress" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>