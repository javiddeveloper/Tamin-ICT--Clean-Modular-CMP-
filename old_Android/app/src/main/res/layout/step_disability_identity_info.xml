<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView
        android:id="@+id/identityStepper"
        style="@style/VerticalStepperItemView"
        app:nextStepEnable="false"
        app:step_index="3"
        app:step_state="normal"
        app:step_title="@string/identity_and_call_info"
        tools:step_state="selected">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_2sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/layoutRecycler"
                    android:background="@drawable/bg_item_blue"
                    android:elevation="@dimen/_10sdp"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerInfo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/_5sdp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnShowDetail"
                        style="@style/TextButton"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:text="@string/show_detail"
                        tools:visibility="visible" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
                    android:id="@+id/edLandlinePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintTop_toBottomOf="@+id/layoutRecycler"
                    app:editText_max_len="11"
                    app:editText_hint='@string/landline_number' />

                <com.tamin.taminhamrah.widget.edittext.string.EditTextString
                    android:id="@+id/edAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/edLandlinePhone"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:editText_hint='@string/location_address'
                    app:type="address"/>

                <androidx.appcompat.widget.AppCompatCheckBox
                    style="@style/CheckBoxStepperStyle"
                    android:id="@+id/cbConfirmIdentityStep"
                    android:checked="false"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/edAddress"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDescCommitment"
                    style="@style/TextStyle.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:justificationMode="inter_word"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/desc_confirm_Identity_info"
                    app:layout_constraintEnd_toStartOf="@+id/cbConfirmIdentityStep"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cbConfirmIdentityStep" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView>
</layout>

