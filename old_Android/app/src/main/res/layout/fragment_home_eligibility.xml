<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.login.eligibility.EligibilityHomeViewModel" />
    </data>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        tools:showIn="@layout/fragment_home_eligibility"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr"
            android:textDirection="rtl">

            <include  android:id="@+id/layHeader"
                layout="@layout/view_toolbar_login"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvExplain"
                style="@style/TextStyle.Header"
                android:layout_width="0dp"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_30dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:text="@string/explain_eligibility_treatment"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layHeader" />

            <com.tamin.taminhamrah.widget.edittext.nationalcode.EditTextNationalCode
                android:id="@+id/widgetNationalCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginStart="@dimen/margin_20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvExplain"/>

            <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
                android:id="@+id/widgetForeignNationalsCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvExplain"
                app:editText_hint="@string/foreign_nationals_code"
                app:editText_max_len="10"
                app:editText_max_line="1"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvInquiryForeignNationals"
                style="@style/TextStyle.Title"
                android:textColor="@color/textColorSubTitle"
                android:text="@string/inquiry_foreign_nationals"
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                app:layout_constraintTop_toBottomOf="@+id/widgetNationalCode"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swChangeInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:theme="@style/AppThemeSwitch"
                app:layout_constraintStart_toStartOf="@+id/widgetNationalCode"
                app:layout_constraintTop_toBottomOf="@+id/widgetNationalCode" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnInquiry"
                style="@style/MainButton"
                android:layout_marginTop="@dimen/margin_40dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:text="@string/inquiry_eligibility"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvInquiryForeignNationals"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
</layout>
