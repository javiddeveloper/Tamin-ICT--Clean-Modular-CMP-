<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_blue"
        android:elevation="5dp"
        android:paddingBottom="@dimen/_10sdp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleStatus"
            style="@style/TextStyle.SubTitle"
            android:layout_width="wrap_content"
            android:layout_margin="@dimen/_12sdp"
            android:drawablePadding="@dimen/_2sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_5sdp"
            android:text="@string/status_payment_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitlePatientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/TextStyle.SubTitle"
            android:layout_margin="@dimen/margin_20dp"
            android:text="@string/label_patient_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_center"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleStatus" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValuePatientName"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_marginHorizontal="@dimen/margin_20dp"
            android:ellipsize="end"
            android:gravity="right|center_vertical"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitlePatientName"
            app:layout_constraintEnd_toStartOf="@+id/guideline_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitlePatientName"
            tools:text="سعید هنری" />

        <View
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@color/lineColor"
            app:layout_constraintTop_toBottomOf="@id/tvValuePatientName" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleReceptionNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_20dp"
            style="@style/TextStyle.SubTitle"
            android:text="@string/label_reception_number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideline_center"
            app:layout_constraintTop_toBottomOf="@id/line1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueReceptionNumber"
            style="@style/TextStyle.Title"
            android:layout_marginHorizontal="@dimen/margin_20dp"
            android:background="@drawable/bg_btn_dialog_dark_blue"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitleReceptionNumber"
            app:layout_constraintEnd_toStartOf="@+id/guideline_center"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitleReceptionNumber"
            tools:text="132322121" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            style="@style/LinearRecyclerStyle"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/margin_20dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleReceptionNumber" />

        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_height"
            android:background="@color/lineColor"
            app:layout_constraintTop_toBottomOf="@id/recycler" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAction"
            style="@style/TextButtonBordered.ActionButton"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:lines="1"
            android:text="@string/label_actions"
            android:textSize="@dimen/font_sub_title_size"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="@+id/btnShowDetail"
            app:layout_constraintTop_toBottomOf="@+id/recycler"
            app:layout_constraintWidth_percent="0.4" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShowDetail"
            style="@style/TextButton"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/show_detail"
            android:textSize="@dimen/font_sub_title_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAction" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
