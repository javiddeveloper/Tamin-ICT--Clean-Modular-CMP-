<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <import type="com.tamin.taminhamrah.widget.edittext.string.EditTextString.EditTextType" />

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.home.services.girlservivor.GirlSurvivorViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <include
            android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/parent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/_10sdp"
                android:animateLayoutChanges="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPersonalInfo"
                    style="@style/LinearRecyclerStyle"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:background="@drawable/bg_item_blue"
                    app:background="@drawable/bg_item_blue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recyclerPersonalInfo" />

                <com.tamin.taminhamrah.widget.edittext.string.EditTextString
                    android:id="@+id/inputAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:editText_hint ="@string/label_address"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    app:type="address"
                    app:layout_constraintTop_toTopOf="@id/container" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/layout_phone"
                    android:weightSum="2"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    app:layout_constraintTop_toBottomOf="@id/inputAddress"
                    >
                    <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
                    android:id="@+id/inputPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_5sdp"
                    app:editText_hint ="@string/label_phone"
                    app:editText_max_len="11" />

                    <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
                        android:id="@+id/inputZipCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:editText_hint="@string/label_zipcode"
                        app:editText_max_len="10"
                        android:layout_marginStart="@dimen/_5sdp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.tamin.taminhamrah.widget.edittext.nationalcode.EditTextNationalCode
                    android:id="@+id/widgetNationalCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:editText_hint="@string/label_national_code_deceased"
                    app:layout_constraintTop_toBottomOf="@id/layout_phone" />

                <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
                    android:id="@+id/inputPensionId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:visibility="invisible"
                    app:editText_hint="@string/label_pension_id_deceased"
                    app:editText_max_len="10"
                    app:editText_max_line="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_phone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelPensionId"
                    style="@style/TextStyle.Title"
                    android:enabled="false"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:text="@string/label_use_pension_id"
                    android:textColor="@color/textColorSubTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/widgetNationalCode" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swChangeInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:theme="@style/AppThemeSwitch"
                    app:layout_constraintBottom_toBottomOf="@id/labelPensionId"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/labelPensionId" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCheckForm"
                    style="@style/MainButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:text="@string/label_see_survivor_form"
                    app:layout_constraintTop_toBottomOf="@+id/labelPensionId" />

                <View
                    android:id="@+id/containerConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margin_20dp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnCheckForm" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbConfirm"
                    style="@style/TextStyle.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@id/containerConfirm"
                    android:text="@string/label_confirm_girl_survivor_pdf"
                    android:layoutDirection="rtl"
                    android:textDirection="rtl"
                    android:fontFamily="@font/iran_sans_mobile_fa_num"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:padding="@dimen/_10sdp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnConfirm"
                    style="@style/MainButton"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/send_request"
                    app:layout_constraintTop_toBottomOf="@+id/rbConfirm" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:constraint_referenced_ids="containerConfirm, rbConfirm, btnConfirm" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>