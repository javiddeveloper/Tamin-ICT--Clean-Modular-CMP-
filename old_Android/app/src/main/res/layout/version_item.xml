<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_blue"
        android:paddingBottom="@dimen/_12sdp">


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvVersionName"
            style="@style/TextStyle.Title.Bold"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/tvReleaseDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1.2.0" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvReleaseDate"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/clickHolder"
            app:layout_constraintEnd_toEndOf="@+id/tvVersionName"
            app:layout_constraintTop_toBottomOf="@+id/tvVersionName"
            tools:text="چهارشنبه - 16 مهر 1401" />

        <LinearLayout
            android:id="@+id/clickHolder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgArrow"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintBottom_toBottomOf="@+id/tvReleaseDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvVersionName" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupNewFeature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTitleNewFeature,recyclerFeatures" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupBugs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTitleDebugs,recyclerDebugs" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleNewFeature"
            style="@style/TextStyle.Title.Bold"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/new_feature"
            android:textColor="@color/green"
            app:layout_constraintEnd_toEndOf="@+id/tvVersionName"
            app:layout_constraintTop_toBottomOf="@+id/clickHolder" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFeatures"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="@+id/tvVersionName"
            app:layout_constraintStart_toStartOf="@+id/imgArrow"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleNewFeature" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleDebugs"
            style="@style/TextStyle.Title.Bold"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/debug"
            android:textColor="@color/bg_label_new"
            app:layout_constraintEnd_toEndOf="@+id/tvVersionName"
            app:layout_constraintTop_toBottomOf="@+id/recyclerFeatures" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDebugs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"

            app:layout_constraintEnd_toEndOf="@+id/tvVersionName"
            app:layout_constraintStart_toStartOf="@+id/imgArrow"
            app:layout_constraintTop_toBottomOf="@+id/tvTitleDebugs" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
