<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header"
    android:layoutDirection="ltr"
    android:textDirection="rtl">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgLogo"
        android:layout_width="@dimen/margin_82dp"
        android:layout_height="@dimen/margin_63dp"
        android:layout_margin="@dimen/margin_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_logo_tamin" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imbTips"
        style="@style/ImageButton.Clickable"
        android:layout_margin="@dimen/margin_10dp"
        android:background="@drawable/header_bkg"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_tips"
        app:tint="@color/gray_dark" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imbBack"
        style="@style/ImageButton.Clickable"
        android:layout_margin="@dimen/margin_10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>