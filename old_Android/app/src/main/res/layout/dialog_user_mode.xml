<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.login.LoginViewModel" />

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dialog_min_width"
        android:background="@drawable/bg_item_dark_blue_top"
        android:layoutDirection="ltr"
        android:textDirection="rtl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="0dp"
       >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgProfile"
            android:layout_width="@dimen/profile_image_small_size"
            android:layout_height="@dimen/profile_image_small_size"
            android:background="@drawable/ic_account"
            android:adjustViewBounds="true"
            android:layout_marginBottom="@dimen/_25sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="visible"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUsername"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/profile_image_small_size"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toTopOf="@id/line"
            app:layout_constraintEnd_toStartOf="@id/imgProfile"
            app:layout_constraintStart_toStartOf="@id/parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/label_dear_user"
            tools:text=""
            android:visibility="visible"/>

        <View
            android:id="@+id/line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@color/lineColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUsername"
            android:visibility="gone"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelDescription"
            style="@style/TextStyle.Title"
            android:layout_marginBottom="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="@string/select_user_mode"
            app:layout_constraintEnd_toEndOf="@id/parent"
            app:layout_constraintTop_toBottomOf="@id/line"
         />

        <FrameLayout
            android:layout_width="0dp"
            android:id="@+id/mainFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelDescription"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                style="@style/LinearRecyclerStyle"
                android:layout_width="match_parent"
                tools:layout_height="100dp" />

        </FrameLayout>



        <include layout="@layout/view_loading"
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/loadingView"
            tools:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelError"
            style="@style/TextStyle.SubTitle"
            android:layout_marginEnd="@dimen/margin_5dp"
            tools:text="@string/select_user_mode"
            android:textColor="?attr/colorError"
            app:layout_constraintStart_toStartOf="@id/parent"
            app:layout_constraintEnd_toEndOf="@id/parent"
            app:layout_constraintTop_toBottomOf="@id/mainFrame"
            app:layout_constraintBottom_toTopOf="@id/btnOk"
            android:layout_marginTop="@dimen/margin_20dp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            style="@style/MainButton"
            android:layout_width="0dp"
            android:background="@drawable/bg_btn_dialog_dark_blue"
            android:text="@string/cancel"
            android:textColor="@color/black"
            android:backgroundTint="@color/bg_dialog_cancel"
            app:layout_constraintBottom_toBottomOf="@id/btnOk"
            app:layout_constraintEnd_toStartOf="@id/btnOk"
            app:layout_constraintStart_toStartOf="@+id/mainFrame"
            app:layout_constraintTop_toTopOf="@id/btnOk" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOk"
            style="@style/MainButton"
            android:layout_width="0dp"
            android:background="@drawable/bg_btn_dialog_gray"
            android:text="@string/ok"
            android:enabled="false"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/margin_20dp"

            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@id/line2"
            app:layout_constraintEnd_toEndOf="@+id/mainFrame"
            app:layout_constraintStart_toEndOf="@id/btnCancel"
            app:layout_constraintTop_toBottomOf="@id/labelError" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="line2,btnLogOut"
            android:visibility="gone"
            tools:visibility="visible"/>

        <View
            android:id="@+id/line2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/lineColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnOk"
            app:layout_constraintBottom_toTopOf="@id/btnLogOut"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogOut"
            style="@style/TextButton"
            android:drawableEnd="@drawable/ic_exit_to_app"
            android:text="@string/label_logout"
            android:textColor="@color/red"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line2"
            android:layout_marginTop="@dimen/margin_20dp"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>