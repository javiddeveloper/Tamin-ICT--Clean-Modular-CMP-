<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView
        android:id="@+id/stepperVerifyCode"
        style="@style/VerticalStepperItemView"
        app:layout_constraintTop_toBottomOf="@+id/stepperRules"
        app:previousStepVisible="false"
        app:step_index="1"
        app:step_title="@string/label_register_commitment_request"
        app:step_state="selected"
        android:paddingTop="@dimen/_12sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:layoutDirection="rtl"
            android:layout_marginBottom="@dimen/margin_20dp">

            <com.tamin.taminhamrah.widget.edittext.MobileView
                android:id="@+id/inputMobile"
                style="@style/TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                app:editText_max_len="10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.tamin.taminhamrah.widget.edittext.EmailView
                android:id="@+id/inputEmail"
                style="@style/TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                app:editText_max_len="10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/inputMobile"
                app:layout_constraintStart_toStartOf="@id/inputMobile"
                app:layout_constraintTop_toBottomOf="@id/inputMobile" />


            <com.tamin.taminhamrah.widget.edittext.string.EditTextString
                android:id="@+id/inputVerificationCode"
                style="@style/TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                app:editText_max_len="10"
                app:editText_hint ="@string/label_security_ticket"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/labelCountDown"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/labelCountDown"
                style="@style/TextStyle.SubTitle"
                android:gravity="center"
                android:text="@string/label_remaining_time"
                android:layout_marginTop="@dimen/margin_20dp"
                app:layout_constraintBottom_toTopOf="@id/tvCountDown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inputVerificationCode"
                app:layout_constraintVertical_chainStyle="packed" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountDown"
                style="@style/TextStyle.Header"
                android:layout_margin="@dimen/margin_10dp"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/text_color_orange"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labelCountDown" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditInfo"
                style="@style/TextButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_marginBottom="@dimen/margin_20dp"
                android:text="@string/label_edit_info"
              app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCountDown"
                app:layout_constraintBottom_toBottomOf="parent"/>


            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupVerifyCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="inputVerificationCode,labelCountDown,tvCountDown, btnEditInfo"
                android:visibility="gone"/>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="inputMobile,inputEmail "
                android:visibility="visible"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.tamin.taminhamrah.utils.stepperView.VerticalStepperItemView>

</layout>