<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.tamin.taminhamrah.utils.Utility" />

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.home.services.objectionNonExistentHistory.ObjectionNotExistentHistoryViewModel" />

        <variable
            name="item"
            type="com.tamin.taminhamrah.data.remote.models.services.NotExistRequestsResponse" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:animateLayoutChanges="true"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:fitsSystemWindows="true"
        android:focusable="true">

        <include
            android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutShowObjections"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:animateLayoutChanges="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:id="@+id/containerSavedObjection"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginBottom="-20dp"
                        android:background="?attr/colorSurface"
                        app:layout_constraintBottom_toBottomOf="@id/btnSendReq"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/titleObjection"
                        style="@style/TextStyle.Title.Bold"
                        android:layout_marginTop="@dimen/margin_10dp"
                        android:padding="@dimen/margin_20dp"
                        android:text="@string/label_registered_protests"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/createNonExistentHistory"
                        style="@style/TextButtonBordered.Green"
                        android:layout_width="@dimen/margin_150dp"
                        android:layout_marginStart="@dimen/margin_20dp"
                        android:drawableRight="@drawable/ic_add_circle"
                        android:text="@string/label_create_nonexistent_History"
                        android:textSize="@dimen/margin_12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/titleObjection"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/titleObjection" />


                    <com.tamin.taminhamrah.widget.CustomRecyclerView
                        android:id="@+id/recycler"
                        style="@style/LinearPaginationRecyclerStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_10dp"
                        android:layout_marginEnd="@dimen/margin_10dp"
                        android:backgroundTint="@color/white"
                        android:elevation="@dimen/margin_5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/titleObjection" />


                    <com.tamin.taminhamrah.widget.edittext.string.MultiLineEditTextString
                        android:id="@+id/inputDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_20dp"
                        android:layout_marginTop="@dimen/margin_20dp"
                        android:layout_marginEnd="@dimen/margin_20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/recycler" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSendReq"
                        style="@style/MainButton"
                        android:layout_margin="@dimen/margin_20dp"
                        android:text="@string/label_ok_and_send"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/inputDescription" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:animateLayoutChanges="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutShowObjections">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:background="?attr/colorSurface"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/_20sdp"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.tamin.taminhamrah.utils.stepperView.StepperLayout
                            android:id="@+id/stepper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </androidx.appcompat.widget.LinearLayoutCompat>



                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>

