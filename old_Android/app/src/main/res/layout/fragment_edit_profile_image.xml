<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.tamin.taminhamrah.ui.profile.ProfileViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:fitsSystemWindows="false"
        android:focusable="true">

        <include
            android:id="@+id/appBar"
            layout="@layout/view_appbar_service" />

        <include
            android:id="@+id/appbarBackgroundImage"
            layout="@layout/view_appbar_image" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="true"
                android:background="?attr/colorSurface">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="@dimen/profile_image_large_size"
                    android:layout_height="@dimen/profile_image_large_size"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:background="@drawable/ic_account"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelFullName"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:visibility="gone"
                    android:text="@string/full_name"
                    app:layout_constraintBottom_toTopOf="@id/labelNationalCode"
                    app:layout_constraintEnd_toStartOf="@id/imgProfile"
                    app:layout_constraintStart_toEndOf="@id/tvFullName"
                    app:layout_constraintTop_toTopOf="@id/imgProfile"
                    app:layout_constraintVertical_chainStyle="packed" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFullName"
                    style="@style/TextStyle.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_10dp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:text='@{viewModel.mldFetchRelationInfo.data.fullName()}'
                    app:layout_constraintBottom_toTopOf="@+id/tvNationalCode"
                    app:layout_constraintEnd_toStartOf="@+id/imgProfile"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="یلبییبلبییلبییبلبی" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelNationalCode"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:visibility="gone"
                    android:text="@string/label_national_code"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginBottom="@dimen/margin_20dp"
                    app:layout_constraintBottom_toTopOf="@id/labelInsuranceCode"
                    app:layout_constraintEnd_toEndOf="@id/labelFullName"
                    app:layout_constraintStart_toEndOf="@id/tvNationalCode"
                    app:layout_constraintTop_toBottomOf="@id/labelFullName" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNationalCode"
                    style="@style/TextStyle.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:ellipsize="end"
                    android:text='@{viewModel.mldFetchRelationInfo.data.nationalId}'
                    app:layout_constraintBottom_toTopOf="@+id/tvInsuranceCode"
                    app:layout_constraintEnd_toEndOf="@+id/tvFullName"
                    app:layout_constraintTop_toBottomOf="@+id/tvFullName"
                    tools:text="009" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelInsuranceCode"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:text="@string/label_insurance_number"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/imgProfile"
                    app:layout_constraintEnd_toEndOf="@id/labelNationalCode"
                    app:layout_constraintStart_toEndOf="@id/tvInsuranceCode"
                    app:layout_constraintTop_toBottomOf="@id/labelNationalCode" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvInsuranceCode"
                    style="@style/TextStyle.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_7dp"
                    android:ellipsize="end"
                    android:text='@{viewModel.mldFetchRelationInfo.data.insuranceId}'
                    app:layout_constraintBottom_toTopOf="@+id/line"
                    app:layout_constraintEnd_toEndOf="@+id/tvFullName"
                    app:layout_constraintTop_toBottomOf="@+id/tvNationalCode"
                    tools:text="0909" />

                <View
                    android:id="@+id/line"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/line_height"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgProfile"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:background="@color/lineColor"/>


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputSerialNumber"
                    style="@style/TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_margin="@dimen/margin_20dp"
                    android:hint="@string/hint_nationl_code_serial_number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/line">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input"
                        style="@style/EditTextStyle"
                        android:inputType="text"
                        android:maxLength="10"
                        app:editText_hint="@string/account_number" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:srcCompat="@drawable/ic_circle_orange"
                    app:layout_constraintEnd_toEndOf="@+id/inputSerialNumber"
                    app:layout_constraintTop_toBottomOf="@+id/inputSerialNumber" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelHintDesc"
                    style="@style/TextStyle.SubTitle"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/margin_5dp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/hint_nationl_code_serial_number_desc"
                    app:layout_constraintEnd_toStartOf="@+id/imageView2"
                    app:layout_constraintStart_toStartOf="@id/inputSerialNumber"
                    app:layout_constraintTop_toBottomOf="@id/inputSerialNumber" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swChangeRelatedPerson"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:fontFamily="@font/iran_sans_mobile_fa_num"
                    android:layoutDirection="rtl"
                    android:visibility="visible"
                    tools:visibility="visible"
                    android:text="@string/label_select_related_persons"
                    android:textColor="@color/textColorSubTitle"
                    app:layout_constraintEnd_toEndOf="@id/inputSerialNumber"
                    app:layout_constraintStart_toStartOf="@id/inputSerialNumber"
                    app:layout_constraintTop_toBottomOf="@+id/labelHintDesc" />

                <include
                    android:id="@+id/inputRelated"
                    layout="@layout/widget_selectable_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginTop="@dimen/margin_20dp"
                    app:hintselect="@{@string/label_related_persons}"
                    app:layout_constraintEnd_toEndOf="@id/inputSerialNumber"
                    app:layout_constraintStart_toStartOf="@id/inputSerialNumber"
                    app:layout_constraintTop_toBottomOf="@id/swChangeRelatedPerson" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSubmit"
                    style="@style/MainButton"
                    android:layout_width="0dp"
                    android:layout_margin="@dimen/margin_20dp"
                    android:text="@string/send_request"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inputRelated"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
