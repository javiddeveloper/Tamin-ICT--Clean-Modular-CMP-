<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.tamin.taminhamrah.utils.AvatarImageBehavior"/>
        <import type="android.view.View" />

       <!-- <variable
            name="image_resource"
            type="android.graphics.drawable.Drawable" />-->
        <variable
            name="appbarTitle"
            type="String" />

        <variable
            name="sub_title"
            type="String" />

        <variable
            name="sub_sub_title"
            type="String" />
    </data>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="?colorPrimaryDark"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="@android:color/transparent">

            <include  android:id="@+id/toolbar"
                layout="@layout/view_toolbar_service" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/containerAppbarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginTop="60dp"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                app:layout_collapseMode="parallax">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgIcon"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:transitionName="aaaaaaaaaaa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvTitle"
                    app:tint="@color/white"
                    android:src="@drawable/ic_my_request_colorful"
                    app:finalHeight="@dimen/image_final_width"
                    app:finalXPosition="@dimen/spacing_small"
                    app:finalYPosition="@dimen/spacing_small"
                    app:finalToolbarHeight="?attr/actionBarSize"
                    app:layout_behavior="com.tamin.taminhamrah.utils.AvatarImageBehavior"/>



                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle"
                    style="@style/TextStyle.Header.White"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:textDirection="rtl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvSubTitle"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="مجتمع 1"
                    android:textColor="@color/white"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="@dimen/font_header_size"
                    app:autoSizeStepGranularity=".5sp"
                    app:autoSizeTextType="uniform"/>


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSubTitle"
                    style="@style/TextStyle.Title"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/margin_16dp"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:gravity="center"
                    android:textDirection="rtl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:text="aaaaassssssssssssssaaaa"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="@dimen/font_title_size"
                    app:autoSizeStepGranularity=".5sp"
                    app:autoSizeTextType="uniform"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSub_subTitle"
                    style="@style/TextStyle.SubTitle"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textDirection="rtl"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/margin_16dp"
                    android:text='@{sub_sub_title}'
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="1400"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="@dimen/font_sub_title_size"
                    app:autoSizeStepGranularity=".5sp"
                    app:autoSizeTextType="uniform"/>

             </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

</layout>
