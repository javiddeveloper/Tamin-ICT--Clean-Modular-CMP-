<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <import type="android.view.View" />
        <variable
            name="item"
            type="com.tamin.taminhamrah.data.remote.models.services.AllHistoryInsuranceResponseModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayoutSeason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/bg_item_spring"
        android:elevation="@dimen/_2sdp"
        android:orientation="vertical"
        android:padding="@dimen/_2sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleMonth"
            style="@style/TextStyle.SubTitle"
            android:elevation="@dimen/margin_5dp"
            android:text="@string/label_month"
            android:layout_margin="@dimen/margin_10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRegistered"
            style="@style/TextStyle.SubTitle"
            android:elevation="@dimen/margin_5dp"
            android:text="@string/label_registered"
            android:layout_marginEnd="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tvDeclared"
            app:layout_constraintEnd_toStartOf="@+id/tvTitleMonth"
            app:layout_constraintStart_toEndOf="@+id/tvDeclared"
            app:layout_constraintTop_toTopOf="@+id/tvDeclared" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDeclared"
            style="@style/TextStyle.SubTitle"
            android:layout_margin="@dimen/margin_10dp"
            android:elevation="@dimen/margin_5dp"
            android:text="@string/label_declared"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detailRecycler"
            style="@style/LinearRecyclerStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/tvDeclared" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>