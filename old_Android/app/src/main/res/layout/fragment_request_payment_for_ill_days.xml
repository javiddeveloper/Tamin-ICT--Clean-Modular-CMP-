                    app:layout_constraintTop_toBottomOf="@+id/lableDateReciveFromMinistryHealth"
                    app:type="first_name" />

                <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
                    android:id="@+id/inputDoctorCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    app:editText_hint="@string/hint_doctor_code"
                    app:editText_max_len="10"
                    app:layout_constraintEnd_toEndOf="@+id/inputDoctorName"
                    app:layout_constraintStart_toStartOf="@+id/inputDoctorName"
                    app:layout_constraintTop_toBottomOf="@+id/inputDoctorName" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/selectHasMedicalRecordRelatedBreak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:fontFamily="@font/iran_sans_mobile_fa_num"
                    android:layoutDirection="rtl"
                    android:text="@string/label_has_medical_record_related_break"
                    android:textColor="?attr/colorOnBackground"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/inputDoctorCode" />



                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSubmitCommitment"
                    style="@style/MainButton"
                    android:layout_margin="@dimen/margin_20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="@dimen/margin_20dp"
                    android:text="@string/send_request"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutUploadImage"
                    app:layout_constraintVertical_bias="0.0" />

                <View
                    android:id="@+id/containerUpload"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="?attr/colorSurface"
                    android:fillViewport="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/selectHasMedicalRecordRelatedBreak"
                    app:layout_constraintVertical_bias="1.0" />


                <include
                    android:id="@+id/layoutUploadImage"
                    layout="@layout/view_image_picker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginBottom="@dimen/margin_50dp"
                    app:layout_constraintTop_toBottomOf="@+id/selectHasMedicalRecordRelatedBreak" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupSelectDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="widgetDatePickerEndDateRest,widgetDatePickerStartDateRest" />

                <androidx.constraintlayout.widget.Group
                    android:id="@+id/groupReciveDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:constraint_referenced_ids="imageView4,lableDateReciveFromMinistryHealth" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
