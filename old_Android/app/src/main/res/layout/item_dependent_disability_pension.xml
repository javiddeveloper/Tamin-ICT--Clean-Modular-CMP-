<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_3sdp"
    android:background="@drawable/bg_item_blue"
    android:elevation="@dimen/_5sdp"
    android:paddingBottom="@dimen/_5sdp"
    >

    <TextView
        android:id="@+id/tvFullName"
        style="@style/TextStyle.Title.Bold"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.3"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        tools:text="مهدی اسدی"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/tvRelation"
        style="@style/TextStyle.Title"
        android:layout_width="0dp"
        android:background="@drawable/bg_insurance"
        android:gravity="center"
        android:maxLines="1"
        android:padding="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullName"
        app:layout_constraintEnd_toStartOf="@+id/tvFullName"
        app:layout_constraintTop_toTopOf="@+id/tvFullName"
        app:layout_constraintWidth_percent="0.3"
        tools:text="فرزند" />


    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recyclerDetail"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="visible"
        android:layout_marginTop="@dimen/_35sdp"
        />

    <Button
        android:id="@+id/btnShowDetail"
        style="@style/TextButton"
        android:layout_width="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:gravity="center"
        android:text="@string/show_detail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recyclerDetail"
        />

</androidx.constraintlayout.widget.ConstraintLayout>