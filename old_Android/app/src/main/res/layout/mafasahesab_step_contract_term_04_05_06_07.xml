<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">

        <com.tamin.taminhamrah.widget.edittext.number.EditTextNumber
            android:id="@+id/inputConstructorDriverPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:editText_max_len="50"
            app:editText_hint="@string/label_constructor_driver_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDescConstructorDriverPrice"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/margin_5dp"
            android:drawableEnd="@drawable/ic_circle_orange"
            android:text="@string/label_constructor_driver_price_desc"
            app:drawableTint="@color/light_blue"
            app:layout_constraintStart_toStartOf="@id/inputConstructorDriverPrice"
            app:layout_constraintEnd_toEndOf="@id/inputConstructorDriverPrice"
            app:layout_constraintTop_toBottomOf="@id/inputConstructorDriverPrice"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDriverPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescConstructorDriverPrice"
            android:layout_marginTop="@dimen/margin_10dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>