<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.tamin.taminhamrah.data.remote.models.services.workshop.SmsModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:background="@drawable/bg_item_blue"
        android:elevation="2dp"
        android:paddingBottom="@dimen/margin_8dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvIdTitle"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textDirection="rtl"
            android:text="@string/label_id"
            app:layout_constraintBottom_toBottomOf="@+id/tvId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/horizontalSeparator"
            app:layout_constraintTop_toTopOf="@id/tvId"
            tools:text="@string/label_id"
            tools:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvId"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/corner_radius_4dp"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginEnd="@dimen/corner_radius_4dp"
            android:ellipsize="end"
            android:gravity="top|right"
            android:justificationMode="inter_word"
            android:text="@{item.index}"
            android:textDirection="rtl"
            app:layout_constraintEnd_toEndOf="@+id/horizontalSeparator"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2" />


        <androidx.constraintlayout.widget.Guideline

            android:id="@+id/horizontalSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75"

            />

        <LinearLayout
            android:layout_width="@dimen/margin_2dp"
            android:layout_height="0dp"

            android:background="@color/gray_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/horizontalSeparator"
            app:layout_constraintTop_toTopOf="@id/tvId" />

        <LinearLayout
            android:id="@+id/separatorId"
            android:layout_marginTop="@dimen/margin_4dp"

            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@+id/tvId"
            android:orientation="horizontal" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStatusTitle"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_2dp"
            android:layout_marginEnd="@dimen/margin_4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/label_work_status"
            android:textDirection="rtl"
            app:layout_constraintBottom_toBottomOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/horizontalSeparator"
            app:layout_constraintTop_toTopOf="@id/tvStatus"
            tools:text="وضعیت"
            tools:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStatus"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/corner_radius_4dp"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginEnd="@dimen/corner_radius_4dp"
            android:ellipsize="end"
            android:gravity="top|right"
            android:justificationMode="inter_word"
            android:text="@{item.getObjectionStatus}"
            android:textDirection="rtl"
            app:layout_constraintEnd_toEndOf="@+id/horizontalSeparator"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separatorId"
            tools:text="ثبت درخواست" />
        <LinearLayout
            android:id="@+id/separatorStatus"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_2dp"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:background="@color/gray_light"
            android:layout_marginTop="@dimen/margin_4dp"
            app:layout_constraintTop_toBottomOf="@+id/tvStatus"
            android:orientation="horizontal" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvtMessageTitle"
            style="@style/TextStyle.SubTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_2dp"
            android:layout_marginEnd="@dimen/margin_4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/sms_message"
            android:textDirection="rtl"
            app:layout_constraintBottom_toBottomOf="@+id/tvMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/horizontalSeparator"
            app:layout_constraintTop_toTopOf="@id/tvMessage"
            tools:text="@string/sms_message"
            tools:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMessage"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/corner_radius_4dp"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginEnd="@dimen/corner_radius_4dp"
            android:ellipsize="end"
            android:gravity="top|right"
            android:text="@{item.smsDescription}"
            android:justificationMode="inter_word"
            android:textDirection="rtl"
            app:layout_constraintEnd_toEndOf="@+id/horizontalSeparator"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separatorStatus"
            tools:text="ثبت درخواست" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
