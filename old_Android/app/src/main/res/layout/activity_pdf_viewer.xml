<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:filterTouchesWhenObscured="true"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        android:background="?attr/colorPrimaryDark"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/imageBack"
                style="@style/ImageButton.Clickable"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_arrow_back"
                android:layout_margin="@dimen/margin_8dp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvToolbarTitle"
                style="@style/TextStyle.Title"
                android:textColor="@android:color/white"
                android:layout_width="0dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imageBack"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="سیمب سیبنت" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnDownload"
                style="@style/ImageViewIcon"
                app:srcCompat="@drawable/ic_download"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnShare"
                style="@style/ImageViewIcon"
                app:srcCompat="@drawable/ic_share"
                app:layout_constraintStart_toEndOf="@id/btnDownload"
                app:layout_constraintTop_toTopOf="@id/btnDownload"
                app:layout_constraintBottom_toBottomOf="@id/btnDownload"
                />
<!--            <androidx.appcompat.widget.AppCompatImageView-->
<!--            android:id="@+id/btnZoomIn"-->
<!--            style="@style/ImageViewIcon"-->
<!--            app:srcCompat="@drawable/ic_zoom_in"-->
<!--            app:layout_constraintStart_toEndOf="@id/btnShare"-->
<!--            app:layout_constraintTop_toTopOf="@id/btnDownload"-->
<!--            app:layout_constraintBottom_toBottomOf="@id/btnDownload"-->

<!--            />-->

<!--            <androidx.appcompat.widget.AppCompatImageView-->
<!--                android:id="@+id/btnZoomOut"-->
<!--                style="@style/ImageViewIcon"-->
<!--                app:srcCompat="@drawable/ic_zoom_out"-->
<!--                app:layout_constraintStart_toEndOf="@id/btnZoomIn"-->
<!--                app:layout_constraintTop_toTopOf="@id/btnDownload"-->
<!--                app:layout_constraintBottom_toBottomOf="@id/btnDownload"-->

<!--                />-->
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.Toolbar>

   <!-- <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/pdfView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />-->
    <com.rajat.pdfviewer.PdfRendererView
        android:id="@+id/pdfView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintVertical_bias="0.0"
        app:pdfView_divider="@drawable/pdf_viewer_divider"
        app:pdfView_showDivider="false" />

</androidx.constraintlayout.widget.ConstraintLayout>