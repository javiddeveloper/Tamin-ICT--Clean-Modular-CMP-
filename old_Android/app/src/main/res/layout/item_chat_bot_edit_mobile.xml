<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_chat_bot_clickable"
    android:padding="16dp">

    <!-- Expanded View -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/groupExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnCancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="4dp"
            android:tint="@color/material_grey_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_outline" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ویرایش شماره موبایل"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Process Indicators -->
        <LinearLayout
            android:id="@+id/layout_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <View
                android:id="@+id/step3"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/shape_circle_grey" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/grey_color_text_button_bordered" />

            <View
                android:id="@+id/step2"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/shape_circle_grey" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/grey_color_text_button_bordered" />

            <View
                android:id="@+id/step1"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/shape_circle_blue" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_steps"
            tools:visibility="visible" />

        <!-- Step 1: Input New Mobile -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/layout_steps">

            <TextView
                android:id="@+id/tvCurrentMobileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_phone"
                android:textColor="@color/material_grey_500"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/inputMobileCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edit_text_border"
                android:enabled="false"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvCurrentMobileLabel"
                tools:text="09123456789" />

            <TextView
                android:id="@+id/tvNewMobileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/new_phone"
                android:textColor="@color/material_grey_500"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inputMobileCurrent" />

            <EditText
                android:id="@+id/inputMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edit_text_border"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:gravity="center"
                android:hint="09xxxxxxxxx"
                android:inputType="number"
                android:maxLength="11"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvNewMobileLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/material_blue_500"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:padding="12dp"
                android:text="@string/send_otp"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/inputMobile" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Step 2: Verify OTP -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_steps"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tvSentTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/material_grey_500"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="کد تایید به شماره 09123456789 ارسال شد" />

            <LinearLayout
                android:id="@+id/layoutEditNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSentTo">

                <TextView
                    android:id="@+id/btnEditNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:padding="8dp"
                    android:text="@string/edit_phone"
                    android:textColor="@color/material_blue_500"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_edit_mobile" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputVerifyCode"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_border"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:gravity="center"
                android:hint="- - - -"
                android:inputType="number"
                android:maxLength="6"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:letterSpacing="0.2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutEditNumber" />

            <TextView
                android:id="@+id/tvCountDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:textColor="@color/material_grey_500"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inputVerifyCode"
                tools:text="02:00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/material_blue_500"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:padding="12dp"
                android:text="تایید و ثبت"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvCountDown" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Step 3: Success/Error -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_steps"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/imgStatus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_check_circle_green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/imgStatus"
                tools:text="ویرایش شماره موبایل" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/green_dark"
                android:textSize="16sp"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                app:layout_constraintTop_toBottomOf="@id/tvResultTitle"
                tools:text="عملیات با موفقیت انجام شد" />

            <TextView
                android:id="@+id/tvBottomMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/material_grey_500"
                android:textSize="12sp"
                android:fontFamily="@font/iran_sans_mobile_fa_num"
                app:layout_constraintTop_toBottomOf="@id/tvMessage"
                tools:text="شماره موبایل شما به طور دائمی تغییر کرد" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
