<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/corner_radius_4dp" />
        </shape>
    </item>

    <item
        android:bottom="@dimen/margin_4dp"
        android:left="@dimen/margin_4dp"
        android:right="@dimen/margin_4dp"
        android:top="@dimen/margin_4dp">
        <shape android:shape="oval">
            <solid android:color="?colorPrimary" />
            <corners android:radius="@dimen/corner_radius_4dp" />
        </shape>
    </item>
</layer-list>