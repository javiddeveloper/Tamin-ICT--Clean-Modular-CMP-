<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_pressed="true">
    <shape android:shape="rectangle">
        <solid android:color="?button_background_pressed" />
        <corners android:radius="@dimen/corner_radius_35dp"/>
        <stroke android:width="1dp" android:color="?colorAccent"/>
    </shape>
</item>

<item>

    <shape android:shape="rectangle">
        <solid android:color="?button_background_default" />
        <corners android:radius="@dimen/corner_radius_35dp"/>
        <stroke android:width="1dp" android:color="?attr/colorSecondary"/>
    </shape>

</item>
</selector>