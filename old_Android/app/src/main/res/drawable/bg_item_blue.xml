<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/corner_radius_4dp" />
        </shape>
    </item>

    <item
        android:bottom="@dimen/_4sdp"
        android:left="-1dp"
        android:right="-1dp"
        android:top="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners
                android:topLeftRadius="@dimen/corner_radius_4dp"
                android:topRightRadius="@dimen/corner_radius_4dp" />
        </shape>
    </item>

</layer-list>