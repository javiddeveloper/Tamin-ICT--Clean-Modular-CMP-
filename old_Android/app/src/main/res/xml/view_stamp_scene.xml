<?xml version="1.0" encoding="utf-8"?>
<MotionScene 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto"
    motion:defaultDuration="800">
    <ConstraintSet android:id="@+id/start">

    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/ImgView"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_200dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            android:rotation="2"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            android:scaleX="0.77"
            android:scaleY="0.77"
            android:alpha="0.4" />
        <Constraint
            android:id="@+id/tvToolbarTitle"
            motion:layout_constraintEnd_toEndOf="@+id/ImgView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="-16"
            motion:layout_constraintTop_toTopOf="@+id/ImgView"
            motion:layout_constraintStart_toStartOf="@+id/ImgView"
            motion:layout_constraintBottom_toBottomOf="@+id/ImgView"
            motion:layout_constraintVertical_bias="0.0"
            motion:layout_constraintHorizontal_bias="0.501"
            android:scaleX="0.77"
            android:scaleY="0.77"
            android:alpha="0.4" />
    </ConstraintSet>
    <ConstraintSet android:id="@+id/between" >
        <Constraint
            android:id="@+id/ImgView"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_200dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            android:rotation="2"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            android:scaleX="0.7"
            android:scaleY="0.7" />
        <Constraint
            android:id="@+id/tvToolbarTitle"
            motion:layout_constraintEnd_toEndOf="@+id/ImgView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="-17"
            motion:layout_constraintTop_toTopOf="@+id/ImgView"
            motion:layout_constraintStart_toStartOf="@+id/ImgView"
            motion:layout_constraintBottom_toBottomOf="@+id/ImgView"
            motion:layout_constraintVertical_bias="0.0"
            motion:layout_constraintHorizontal_bias="0.501"
            android:scaleX="0.7"
            android:scaleY="0.7" />
        <Constraint
            android:id="@+id/moviePosterImg"
            android:elevation="1dp"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="90dp"
            android:layout_height="0dp"
            android:layout_marginEnd="20dp"
            motion:layout_constraintTop_toTopOf="@id/root_layout"
            motion:layout_constraintDimensionRatio="h,1:1.5" />
    </ConstraintSet>
    <Transition
        android:id="@+id/startTransition"
        motion:constraintSetStart="@+id/start"
        motion:constraintSetEnd="@+id/between"
        motion:autoTransition="animateToEnd"/>

    <Transition
        android:id="@+id/betweenTransition"
        motion:constraintSetStart="@+id/between"
        motion:constraintSetEnd="@+id/end"
        motion:autoTransition="animateToEnd"
        />
</MotionScene>