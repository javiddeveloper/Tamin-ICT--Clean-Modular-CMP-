<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_splash"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.tamin.taminhamrah.ui.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginActivity"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_splash_to_biometric"
            app:destination="@id/biometricFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"/>

        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/mainActivity"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"/>



        <action
            android:id="@+id/action_splash_to_eligibilityHomeFragment"
            app:destination="@id/eligibilityHomeFragment"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"/>

    </fragment>


    <fragment
        android:id="@+id/biometricFragment"
        android:name="com.tamin.taminhamrah.ui.biometric.BiometricAuthFragment"
        android:label="BiometricAuthFragment"
        tools:layout="@layout/fragment_biometric_auth">

        <action
            android:id="@+id/action_biometricFragment_to_mainActivity"
            app:destination="@id/mainActivity"
            app:popUpTo="@id/biometricFragment"
            app:popUpToInclusive="true" />


    </fragment>

    <fragment
        android:id="@+id/eligibilityHomeFragment"
        android:name="com.tamin.taminhamrah.ui.login.eligibility.EligibilityHomeFragment"
        android:label="EligibilityHomeFragment"
        tools:layout="@layout/fragment_home_eligibility"/>

    <activity
        android:id="@+id/loginActivity"
        android:name="com.tamin.taminhamrah.ui.login.LoginActivity"
        android:label="LoginActivity"
        tools:layout="@layout/activity_login"/>

    <activity
        android:id="@+id/mainActivity"
        android:name="com.tamin.taminhamrah.ui.MainActivity"
        android:label="MainActivity"
        tools:layout="@layout/activity_main"/>
</navigation>