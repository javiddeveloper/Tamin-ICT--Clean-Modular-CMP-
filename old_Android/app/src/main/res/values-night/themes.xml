    <style name="AppTheme.InsuredTheme" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Customize your theme here. -->
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>


        <item name="button_background_default">@color/button_background_default_theme1</item>
        <item name="button_background_pressed">@color/button_background_pressed_theme1</item>

    </style>

    <style name="AppTheme.EmployerTheme" parent="AppTheme">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">#01AFBA</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <!-- Customize your theme here. -->
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>

        <item name="button_background_default">@color/button_background_default_theme2</item>
        <item name="button_background_pressed">@color/button_background_pressed_theme2</item>

    </style>

    <style name="BottomSheetDialog"  parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>


    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="addElevationShadow">false</item>

