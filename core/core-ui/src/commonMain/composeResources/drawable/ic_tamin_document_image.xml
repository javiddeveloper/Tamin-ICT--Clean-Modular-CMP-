<!--
  Traced verbatim from the design's «تصویر» document glyph: a rounded frame with a sun and a
  horizon. The SVG draws the frame as `rect x=3.5 y=5 w=17 h=14 rx=2.5` and the sun as
  `circle cx=8.5 cy=10 r=1.5`; both are written as paths here because vector drawables have no
  rect or circle element. Stroke-only on a 24-unit grid, colour a placeholder that every use tints.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M6 5 h12 a2.5 2.5 0 0 1 2.5 2.5 v9 a2.5 2.5 0 0 1 -2.5 2.5 h-12 a2.5 2.5 0 0 1 -2.5 -2.5 v-9 a2.5 2.5 0 0 1 2.5 -2.5 z"
        android:strokeWidth="1.8"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M7 10 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 z"
        android:strokeWidth="1.8"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M4 16 l5 -4 3 3 4 -3.5 4.5 4.5"
        android:strokeWidth="1.8"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
